{
  "$ref": "#/definitions/MyObject",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "MyExportString": {
      "title": "My export string",
      "type": "string"
    },
    "MyObject": {
      "additionalProperties": false,
      "description": "Some description here",
      "properties": {
        "exportString": {
          "$ref": "#/definitions/MyExportString",
          "default": {
            "length": 10
          },
          "description": "Export field description"
        },
        "nullableValue": {
          "title": "Nullable value",
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "number": {
          "type": "number"
        },
        "numberArray": {
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "type": "array"
        },
        "numberValue": {
          "exclusiveMaximum": 10,
          "multipleOf": 3,
          "title": "Number field title",
          "type": "number"
        },
        "optionalValue": {
          "title": "Optional value",
          "type": [
            "number",
            "string"
          ]
        },
        "privateString": {
          "default": "private",
          "description": "Export field description",
          "title": "My private string",
          "type": "string"
        },
        "requiredValue": {
          "title": "Required value",
          "type": [
            "number",
            "string"
          ]
        },
        "stringValue": {
          "format": "date-time",
          "minLength": 10,
          "pattern": "/^\\d+$/",
          "title": "String field title",
          "type": "string"
        }
      },
      "required": [
        "stringValue",
        "numberValue",
        "requiredValue",
        "nullableValue",
        "exportString",
        "privateString",
        "numberArray",
        "number"
      ],
      "title": "Some title here",
      "type": "object"
    }
  }
}
